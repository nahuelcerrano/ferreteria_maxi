{
  "name": "ferreteria-maxi-estilos",
  "private": true,
  "description": "Compilación de los estilos (Tailwind CSS) de Ferretería Maxi",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^4.3.5"
  }
}
