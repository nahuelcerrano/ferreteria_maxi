# Copiar este archivo como ".env" y ajustar los valores.

# Modo depuración. NUNCA usar True en producción.
DEBUG=True

# Clave secreta de Django. Obligatoria cuando DEBUG=False.
# Generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-esta-clave

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Por defecto se usa SQLite (archivo db.sqlite3 en la raíz).
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=mysql://usuario:clave@localhost:3306/ferreteria

# Solo producción (con HTTPS): activar HSTS una vez verificado que todo el sitio
# funciona por https. Ej.: 31536000 (1 año). Ver docs de Django antes de activarlo.
# SECURE_HSTS_SECONDS=0
# CSRF_TRUSTED_ORIGINS=https://midominio.com
